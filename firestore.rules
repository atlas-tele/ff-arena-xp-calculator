rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // App state contains player records, XP, ranks, settings and audit history.
    match /appData/{documentId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    // Users may read only their own role document. Roles must be assigned manually
    // in Firebase Console; clients cannot promote themselves to admin.
    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
